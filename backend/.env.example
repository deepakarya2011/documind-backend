# -----------------------------------------------------------------------------
# Configuration for the AI PDF Chatbot (OpenRouter edition)
#
# 1. Copy this file to ".env" in the PROJECT ROOT (the dot matters):
#        Copy-Item backend\.env.example .env
# 2. Paste your real OpenRouter API key below.
# 3. NEVER commit the real ".env" file to GitHub (it is in .gitignore).
# -----------------------------------------------------------------------------

# Your secret API key from https://openrouter.ai/keys
# Keys start with "sk-or-" — never share it or commit it to GitHub.
OPENROUTER_API_KEY=sk-or-your-key-here

# Model route used to generate answers (any route on
# https://openrouter.ai/models works, e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Comma-separated deployed frontend origins for browser CORS, e.g.
# FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=
# Optional: how many chunks are retrieved per question (default 4)
RETRIEVAL_TOP_K=4

